UAG(DEFAULT) {
    "client"
}

AUTHORITY("EPICS Root Certificate Authority") {
    AUTHORITY(CMS_AUTH, "intermediateCA")
}

# The second and third entries name parts of the peer certificate's subject
# rather than a person.  The second admits anyone whose certificate says they
# are in staff, which is within beamline, at lbnl, whatever their name.  The
# third admits any holder of a certificate generated by gen_test_certs, and is
# what testsubjectacl decides its access on.  A value carrying a space is
# wrapped in single quotes.
UAG(BAR) {
    "michael",
    "OU=staff,OU=beamline,O=lbnl",
    "OU='epics.org Certificate Authority',O=certs.epics.org"
}

ASG(RO) {
    RULE(1,READ,TRAPWRITE)
}

ASG(SPECIAL) {
    RULE(1,WRITE,TRAPWRITE) {
        UAG(DEFAULT)
        UAG(BAR)
	AUTHORITY(CMS_AUTH)
	METHOD(x509)
	PROTOCOL(tls)
    }
}
